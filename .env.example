# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# Google AI Studio key (https://aistudio.google.com/apikey) — script, translation, TTS
GEMINI_API_KEY=

# Cloudflare Workers AI (https://dash.cloudflare.com → AI → Workers AI → "Use REST API")
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Narration engine: gemini (default; needs a TTS model visible to your key, see `python -m pipeline models`)
# or edge (Microsoft neural voices, no key; am-ET-AmehaNeural male / am-ET-MekdesNeural female)
# TTS_PROVIDER=edge
# EDGE_TTS_VOICE=am-ET-AmehaNeural
# EDGE_TTS_RATE=-8%

# Optional model overrides (defaults live in pipeline/config.py).
# Free-tier model names move often — check AI Studio / Cloudflare catalog and note changes in FAILURES.md.
# GEMINI_TEXT_MODEL=gemini-3.8-flash
# GEMINI_LITE_MODEL=gemini-3.8-flash-lite
# GEMINI_TTS_MODEL=gemini-3.8-flash-preview-tts
# Comma-separated models tried in order when the main one stays overloaded (503):
# GEMINI_TEXT_FALLBACKS=gemini-3.8-flash-lite,gemini-2.5-flash
# GEMINI_TTS_FALLBACKS=gemini-2.5-flash-preview-tts
# CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
