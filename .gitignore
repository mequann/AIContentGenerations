# Secrets (any .env variant; only the template is tracked)
.env
.env.*
!.env.example
*.key
kaggle.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Scratch / intermediate (final outputs ARE committed so the run can be inspected)
outputs/_tmp/
outputs/**/*.part
kaggle/out/
.DS_Store
Thumbs.db

# Real photos of real people stay private (pipeline falls back to the prompt if absent)
assets/photos/*
!assets/photos/README.md
